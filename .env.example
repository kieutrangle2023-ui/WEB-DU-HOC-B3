# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend (Tuần 3+).
# Ở bản UI hiện tại (Tuần 1), toàn bộ dữ liệu là mock — chưa cần các biến này để chạy `npm run dev`.

# Gemini (Tuần 2: chatbot QnA trả lời thật)
GEMINI_API_KEY=

# Supabase — dùng riêng phía server (route handler) để lưu lịch sử chat, KHÔNG có tiền tố
# NEXT_PUBLIC_ vì trình duyệt không được phép truy cập database trực tiếp.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Supabase phía client (Tuần 3: database công khai + Tuần 6: auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
